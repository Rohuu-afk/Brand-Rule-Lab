# ============================================================
# Brand Rule Lab — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env to Git.
# ============================================================

# Optional legacy provider selector; default is NVIDIA NIM with Gemini fallback.
AI_PROVIDER=nvidia

# NVIDIA NIM is primary. Add an NVIDIA API key from the NVIDIA build.nvidia.com portal.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TIMEOUT_SECONDS=40.0

# Google Gemini is used when NVIDIA NIM is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Gemini model fallback for Google service errors.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Gemini request timeout in seconds (suitable for full LLM extraction & inference)
GEMINI_TIMEOUT_SECONDS=60.0

# Require configured OpenID Connect SSO and disable all password sign-in,
# invitation registration, and password recovery flows in production.
# Keep 0 only for local/demo workspaces that intentionally allow passwords.
BRL_REQUIRE_SSO=0

# Public demo entry is opt-in and only appears when DATABASE_PATH points to an
# isolated judge_demo*.db file. Use synthetic demo accounts and passwords only.
BRL_DEMO_ACCESS=0
DEMO_CREATOR_PASSWORD=
DEMO_REVIEWER_PASSWORD=
DEMO_FACT_OWNER_PASSWORD=
DEMO_OWNER_PASSWORD=

# Optional live CMS draft integrations. All connections create drafts only;
# Brand Rule Lab has no publish operation.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_TIMEOUT_SECONDS=15
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_TIMEOUT_SECONDS=15
CONTENTFUL_SPACE_ID=
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_CONTENT_TYPE_ID=
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_LOCALE=en-US
CONTENTFUL_TITLE_FIELD_ID=title
CONTENTFUL_CONTENT_FIELD_ID=content
CONTENTFUL_TIMEOUT_SECONDS=15

# Transactional email via Resend (invites, account verification, password resets).
# Resend's onboarding@resend.dev sender is restricted to verified recipients;
# switch EMAIL_FROM to an address on your verified production domain when ready.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
PUBLIC_APP_URL=http://localhost:8501
ALLOW_DEV_AUTH_LINKS=0

# SQLite database path (relative to project root)
DATABASE_PATH=data/brand_rule_lab.db

# Local directory for validated uploaded assets
UPLOADS_PATH=data/uploads

# Max upload size in megabytes
MAX_UPLOAD_MB=10
MAX_VIDEO_MB=100
MAX_VIDEO_DURATION_SECONDS=120
MAX_VIDEO_KEYFRAMES=12
MAX_VIDEO_FRAME_DIMENSION=1280
MAX_PDF_PAGES=200
MAX_PDF_RENDER_PIXELS=200000000
PDF_RENDER_SCALE=2.0
MAX_IMAGE_PIXELS=40000000
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNCOMPRESSED_MB=100
MAX_ARCHIVE_ENTRY_MB=20
MAX_ARCHIVE_COMPRESSION_RATIO=100

# Optional OCR overrides. Tesseract must be installed separately on local systems.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
# Linux containers can use the installed tesseract binary on PATH.

# Optional override used only by db/create_judge_demo.py; leave unset for its safe default.
# JUDGE_DEMO_DATABASE_PATH=data/judge_demo_round2_20261106.db

# Streamlit port (optional, Render sets PORT automatically)
PORT=8501
